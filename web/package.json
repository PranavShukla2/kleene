{
  "name": "kleene-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc -b && vite build",
    "preview": "vite preview",
    "wasm": "wasm-pack build ../crates/kleene-wasm --target web --out-dir pkg --release",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "elkjs": "^0.12.0",
    "motion": "^13.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^25.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
